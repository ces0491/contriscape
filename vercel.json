{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "contriscape.vercel.app" }],
      "destination": "https://contriscape.sheetsolved.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:login([A-Za-z0-9][A-Za-z0-9-]{0,38})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|Discordbot|WhatsApp|TelegramBot|Pinterest|redditbot|Embedly|SkypeUriPreview|Mastodon|Bluesky|Iframely|vkShare).*"
        }
      ],
      "destination": "/api/share/:login"
    },
    { "source": "/:login([A-Za-z0-9][A-Za-z0-9-]{0,38})", "destination": "/index.html" },
    {
      "source": "/:login([A-Za-z0-9][A-Za-z0-9-]{0,38})/:year(\\d{4})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|Discordbot|WhatsApp|TelegramBot|Pinterest|redditbot|Embedly|SkypeUriPreview|Mastodon|Bluesky|Iframely|vkShare).*"
        }
      ],
      "destination": "/api/share/:login?year=:year"
    },
    { "source": "/:login([A-Za-z0-9][A-Za-z0-9-]{0,38})/:year(\\d{4})", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
